# Clerk authentication — copy the matching pair from your Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_with_your_publishable_key"
CLERK_SECRET_KEY="sk_test_replace_with_your_secret_key"

# Connected document service. Local reading works without a backend.
NEXT_PUBLIC_API_URL="http://localhost:8000"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_BILLING_ENABLED="false"

# Groq AI — server-only key. Create one at https://console.groq.com/keys
GROQ_API_KEY=""

# Private cloud PDFs — connect a private Vercel Blob store to this project.
BLOB_READ_WRITE_TOKEN=""

# Require sign-in for AI in production; development on localhost allows guests.
AI_ALLOW_GUESTS="false"

# Optional: retain the older remote document backend and cloud-sync controls.
NEXT_PUBLIC_ENABLE_LEGACY_BACKEND="false"
