# Local frontend configuration — replace placeholders with your own values.
# Copy this file to .env.local. Never commit real secrets.

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Backend API (hosted separately from this frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional billing configuration from the original environment template.
# Confirm requirements against your Clerk account and backend.
NEXT_PUBLIC_CLERK_BILLING_ENABLED=true
CLERK_BILLING_WEBHOOK_SECRET=YOUR_CLERK_BILLING_WEBHOOK_SECRET
NEXT_PUBLIC_CLERK_PLAN_STARTER_URL=https://YOUR_CLERK_DOMAIN/plans/starter
NEXT_PUBLIC_CLERK_PRICING_TABLE_ID=YOUR_CLERK_PRICING_TABLE_ID

# Supabase values retained from the original template.
# The checked-in frontend does not use a Supabase client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
